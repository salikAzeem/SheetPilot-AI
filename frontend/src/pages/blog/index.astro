---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../utils/blogData';

// Fetch categories
const categories = ['All', 'Google Sheets', 'Excel', 'CSV', 'Automation', 'Productivity', 'AI'];

// Handle dynamic filtering based on search params (SSR / SSG fallback)
const activeCategory = Astro.url.searchParams.get('category') || 'All';
const searchQuery = Astro.url.searchParams.get('q') || '';

let filteredPosts = blogPosts;

if (activeCategory !== 'All') {
  filteredPosts = filteredPosts.filter(post => post.category === activeCategory);
}

if (searchQuery) {
  filteredPosts = filteredPosts.filter(post => 
    post.title.toLowerCase().includes(searchQuery.toLowerCase()) || 
    post.description.toLowerCase().includes(searchQuery.toLowerCase())
  );
}
---

<Layout 
  title="Spreadsheet Automation Blog | SheetPilot AI" 
  description="Master Google Sheets automation, Excel duplicates removal, and AI spreadsheet data cleaning. Read tips from our expert team."
>
  <div className="bg-canvas-soft text-ink font-sans min-h-screen pb-16 relative">
    <div className="mesh-gradient-bg" />

    {/* Top Header */}
    <header className="sticky top-0 bg-canvas/80 backdrop-blur-md border-b border-hairline h-16 flex items-center justify-between px-6 md:px-12 z-40">
      <div className="flex items-center gap-2">
        <a href="/" className="flex items-center gap-2">
          <div className="p-1 bg-primary text-on-primary rounded">
            <svg className="w-5 h-5 fill-on-primary" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 3.8L19.2 18H4.8L12 5.8z"/></svg>
          </div>
          <span className="font-semibold text-base tracking-tight">SheetPilot AI</span>
        </a>
      </div>
      <div className="flex items-center gap-3">
        <a href="/auth/login" className="btn-primary h-8 px-4 text-xs">Get Started</a>
      </div>
    </header>

    {/* Blog Banner Hero */}
    <section className="max-w-4xl mx-auto px-6 pt-16 pb-8 text-center space-y-4">
      <span className="font-mono text-xs uppercase tracking-wider text-mute">Knowledge Hub</span>
      <h1 className="display-lg text-ink font-semibold">Spreadsheet & AI Guides.</h1>
      <p className="text-body text-sm max-w-md mx-auto">Learn how to clean datasets, remove duplicate values, and automate reports with Gemini AI.</p>
    </section>

    {/* Filters and Search */}
    <section className="max-w-4xl mx-auto px-6 py-6 space-y-4">
      <div className="flex flex-col sm:flex-row gap-3 items-center justify-between">
        
        {/* Category Pills */}
        <div className="flex flex-wrap gap-1.5 self-start">
          {categories.map((cat) => (
            <a
              href={`/blog?category=${cat}${searchQuery ? `&q=${searchQuery}` : ''}`}
              className={`px-3 py-1 text-xs rounded-full border transition-all ${
                activeCategory === cat 
                  ? 'bg-primary text-on-primary border-primary' 
                  : 'bg-canvas border-hairline text-body hover:border-hairline-strong hover:text-ink'
              }`}
            >
              {cat}
            </a>
          ))}
        </div>

        {/* Search input form */}
        <form method="GET" className="relative w-full sm:max-w-xs">
          {activeCategory !== 'All' && <input type="hidden" name="category" value={activeCategory} />}
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Search articles..."
            className="input-field h-8 text-xs pl-8 w-full"
          />
          <svg className="w-3.5 h-3.5 text-mute absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </form>

      </div>
    </section>

    {/* Blog list grid */}
    <section className="max-w-4xl mx-auto px-6">
      {filteredPosts.length === 0 ? (
        <div className="p-12 border border-hairline border-dashed rounded-xl text-center text-xs text-mute bg-canvas font-mono">
          No articles match search parameters.
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {filteredPosts.map((post) => (
            <article className="card-mktg flex flex-col justify-between space-y-4 bg-canvas">
              <div className="space-y-2">
                <div className="flex justify-between items-center text-[10px] text-mute font-mono">
                  <span className="px-2 py-0.5 bg-canvas-soft-2 border border-hairline rounded text-body uppercase">{post.category}</span>
                  <span>{new Date(post.publishDate).toLocaleDateString()}</span>
                </div>
                <h2 className="text-sm font-semibold text-ink leading-tight hover:text-link transition-colors">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p className="text-xs text-body leading-relaxed line-clamp-3">{post.description}</p>
              </div>
              <a
                href={`/blog/${post.slug}`}
                className="text-xs font-semibold text-primary inline-flex items-center gap-1 hover:underline pt-2 self-start"
              >
                Read Article
                <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>

  </div>
</Layout>
